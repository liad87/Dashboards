table Fact_Errors
	lineageTag: b2431c59-9b12-449e-a1a5-3835e7ba9b80

	measure 'Total Errors' = COUNT(Fact_Errors[error_created])
		formatString: 0
		lineageTag: 45fe1eb3-560e-4254-9000-6f995acce5fc

	measure 'AVG Duration Error' = DIVIDE(SUM(Fact_Errors[duration_seconds]) ,count(Fact_Errors[duration_seconds]))
		lineageTag: c5506a22-eff9-49b2-a0fd-9edeb251e4dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Error Days' = CALCULATE(COUNT(VDim_Dates[date]) ,Fact_Errors)
		formatString: 0
		lineageTag: 6305e539-d334-4da0-b976-b027d1cdd66e

	measure 'Errors Daily AVG' = DIVIDE([Total Errors] ,[Error Days])
		formatString: 0.0
