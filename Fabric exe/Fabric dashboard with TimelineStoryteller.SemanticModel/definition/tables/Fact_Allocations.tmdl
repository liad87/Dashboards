table Fact_Allocations
	lineageTag: 5d864d98-5da7-4f03-afca-b153733fb533

	measure Allocations = COUNT(Fact_Allocations[created])
		formatString: #,0
		lineageTag: 8c178536-f764-4741-8e1f-a7aa19265256

	measure 'Robots Count' = DISTINCTCOUNT(Fact_Allocations[robot_id])
		formatString: #,0
		lineageTag: ce18e74f-6894-4e21-ad80-b2097a92c869

	measure 'Total Duration Sec' = SUM(Fact_Allocations[duration_sec])
		formatString: #,0
		lineageTag: 5c1d4540-0489-47c9-9f69-5ab00dd0fd5d

	measure 'AVG Allocations Duration' = ```
			DIVIDE([Total Duration Sec] , Fact_Allocations[Allocations] ) 
			```
		formatString: 0
		lineageTag: 7b490a1b-a65c-460e-97ce-dd15f4a391e4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Jobs Count' = CALCULATE(COUNT(Dim_Jobs[job_id] ) ,Fact_Allocations)
		formatString: 0
		lineageTag: 04767d6a-a9e6-4864-b310-faa268a5e4a5

	measure 'AVG Job Duration' = ```
			DIVIDE(  CALCULATE(SUM(Dim_Jobs[Job_Duration]),Fact_Allocations) , [Jobs Count]) 
			```
		formatString: 0.0
		lineageTag: 3ef09ac2-c1c6-4757-99af-c718b0d6db41

	measure 'Total Job Errors' = sum(Fact_Allocations[errors_count])
		formatString: 0
		lineageTag: b48c4f2a-3e80-44bf-895c-facb18f8e8d6

	measure 'Median Allocation Duration' = Median(Fact_Allocations[duration_sec])
		lineageTag: 06e310e6-70ad-4006-a752-e2f00614eb26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Q3_Total = DISTINCTCOUNT(Fact_Allocations[__Unique_Robot_Job_ID])
		formatString: #,0
		lineageTag: c6730037-d185-40b6-a01b-32196a9aecf6

	measure Duration_T_statistic =
			
			VAR AVG_Dur_Reg = CALCULATE([AVG Allocations Duration] ,FILTER(Fact_Allocations , Fact_Allocations[has_an_error] = 0 ) )
			VAR AVG_Dur_Err = CALCULATE([AVG Allocations Duration] ,FILTER(Fact_Allocations ,  Fact_Allocations[has_an_error] = 1 ) )
			VAR Reg_std = CALCULATE(STDEV.P(Fact_Allocations[duration_sec]) ,FILTER(Fact_Allocations , Fact_Allocations[has_an_error] = 0) )
			VAR Err_std = CALCULATE(STDEV.P(Fact_Allocations[duration_sec])  ,FILTER(Fact_Allocations ,Fact_Allocations[has_an_error] = 1 ) )
			Var N_Reg = CALCULATE(COUNT(Fact_Allocations[duration_sec]) , FILTER(Fact_Allocations , Fact_Allocations[has_an_error] = 0 ) )
			Var N_Err = CALCULATE(COUNT(Fact_Allocations[duration_sec]) ,FILTER(Fact_Allocations , Fact_Allocations[has_an_error] = 1  ) )
			Return
			(AVG_Dur_Err - AVG_Dur_Reg)/SQRT( (Reg_std^2/N_Reg)+ (Err_std^2/N_Err) )
		lineageTag: f0f2f30e-456c-407d-9129-dff2f7eee96f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P_value Error Duration Test' =
			
			1 -  NORM.DIST (ABS ( [Duration_T_statistic]),0, 1, TRUE )
		formatString: 0.0000
		isHidden
		lineageTag: a6d25d21-8b93-4f52-9274-ff1caae66959

		changedProperty = IsHidden

	measure 'Sig Err Dur Test' = ```
			
			1 -  T.DIST( ABS([Duration_T_statistic]),SUM(Fact_Allocations[has_an_error]) -1  ,TRUE ) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f32de9e1-d49c-4d72-9ba4-2720992e6ca9

	measure 'AVG Robot Allocation' = ```
			DIVIDE(Fact_Allocations[Allocations] , [Robots Count]) 
			```
		formatString: 0.0
		lineageTag: e35bfba2-01f7-47d1-881e-3be219f699df

	measure 'AVG TOTE Allocations' = DIVIDE(Fact_Allocations[Allocations], DISTINCTCOUNT(Fact_Allocations[tote_id]) )
		lineageTag: af8e1118-a932-442b-9ca6-60726fd3dc26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Allocation Days' = CALCULATE(COUNT(VDim_Dates[date]) ,Fact_Allocations)
		formatString: 0
		lineageTag: 1592833c-a868-4a2e-adc8-4b3d0159172f

	measure 'Allocations Daily AVG' = DIVIDE(Fact_Allocations[Allocations] , [Allocation Days])
		lineageTag: 73cb2881-6650-4c16-a61c-36f505747585

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Job Count Daily AVG' = DIVIDE([Jobs Count] , [Allocation Days])
		formatString: 0.0
		lineageTag: 724ac511-e43a-4253-a84b-d75054aef077

	/// Fixed numeric period length, in days, used by the Last X Days measures.
	measure 'Compared Days' = 3
		formatString: 0
		displayFolder: Last X Days
		lineageTag: ddad294e-4b14-41a0-9cf5-ffa9bbfea19d

	measure 'Allocation Days - Last X Days' =
			VAR EndDate = MAX(VDim_Dates[date])
			RETURN
			    CALCULATE(
			        [Allocation Days],
			        DATESINPERIOD(VDim_Dates[date], EndDate, -[Compared Days] + 1, DAY)
			    )
		formatString: 0
		displayFolder: Last X Days
		lineageTag: 5ca79d86-254c-4991-8d82-0505f37e7a02

	measure 'Allocations Daily AVG - Last X Days' =
			VAR EndDate = MAX(VDim_Dates[date])
			RETURN
			    CALCULATE(
			        [Allocations Daily AVG],
			        DATESINPERIOD(VDim_Dates[date], EndDate, -[Compared Days] + 1, DAY)
			    )
		displayFolder: Last X Days
		lineageTag: c1734422-13f4-43dd-8f7d-99a4f8d999ea

	measure 'Job Count Daily AVG - Last X Days' =
			VAR EndDate = MAX(VDim_Dates[date])
			RETURN
			    CALCULATE(
			        [Job Count Daily AVG],
			        DATESINPERIOD(VDim_Dates[date], EndDate, -[Compared Days] + 1, DAY)
			    )
		formatString: 0.0
		displayFolder: Last X Days
		lineageTag: 4a2d1f8f-208c-466d-bc1c-20d1577923cf

	measure 'Error Days - Last X Days' =
			VAR EndDate = MAX(VDim_Dates[date])
			RETURN
			    CALCULATE(
			        [Error Days],
			        DATESINPERIOD(VDim_Dates[date], EndDate, -[Compared Days] + 1, DAY)
			    )
		formatString: 0
		displayFolder: Last X Days
		lineageTag: bdb38a7d-7ab8-41ef-a1a5-dfa5ca1e89f3

	measure 'Errors Daily AVG - Last X Days' =
			VAR EndDate = MAX(VDim_Dates[date])
			RETURN
			    CALCULATE(
			        [Errors Daily AVG],
			        DATESINPERIOD(VDim_Dates[date], EndDate, -[Compared Days] + 1, DAY)
			    )
		formatString: 0.0
		displayFolder: Last X Days
		lineageTag: 3d3282f0-d963-41b5-a8e5-b733a00a4de7

	measure 'AVG Allocations Duration - Last X Days' =
			VAR EndDate = MAX(VDim_Dates[date])
			RETURN
			    CALCULATE(
			        [AVG Allocations Duration],
			        DATESINPERIOD(VDim_Dates[date], EndDate, -[Compared Days] + 1, DAY)
			    )
		formatString: 0
		displayFolder: Last X Days
		lineageTag: 7157bf73-2728-4d95-993a-f7a9870c409f

