model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Fact_Errors","Fact_Allocations","VDim_Dates","Robots_Allocation_Distribution_to_Jobs","Dim_Jobs","Dim_Time"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_Errors
ref table Fact_Allocations
ref table VDim_Dates
ref table Robots_Allocation_Distribution_to_Jobs
ref table Dim_Jobs
ref table Dim_Time

ref cultureInfo en-US

